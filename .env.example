PORT=4000
API_KEY=your-secure-api-key-here
SALT=10
NODE_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017/clubhouse
OPENAI_API_KEY=
AGORA_KEY=
PUBNUB_PUB_KEY=
PUBNUB_SUB_KEY=
INVITE_ALLOW_LIST=
# AI defaults (authoritative default in code: gpt-4o-mini / 0.4 / 150 tokens)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=150
OPENAI_TEMPERATURE=0.4
# Optional: room sync polling interval in ms (default 15000 in code)
# ROOM_SYNC_INTERVAL_MS=15000
# Credential encryption key (AES-256-GCM). REQUIRED in production.
# - Format: 64-char hex, or any value (scrypt-stretched to 32 bytes).
# - Do NOT ship a real secret here; generate one and set it only in
#   .env.production (or your secret manager).
# - Losing this key makes already-encrypted credentials UNRECOVERABLE.
# - Development only: if unset, a known dev-only key is used with a warning.
#   Production fails to start without it.
# CREDENTIAL_ENCRYPTION_KEY=
LOG_LEVEL=info