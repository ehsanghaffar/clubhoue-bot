{
  "name": "clubhouse-full-api",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "main": "dist/server.js",
  "author": {
    "email": "ghafarweb@gmail.com",
    "name": "Ein",
    "url": "https://eindev.ir"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "minimatch": "^9.0.7"
    }
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "pnpm exec tsx src/server.ts",
    "dev": "pnpm exec nodemon --exec \"pnpm exec tsx src/server.ts\"",
    "stop": "pm2 stop clubhouse-full-api",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .js,.ts . --fix",
    "lic": "pnpm exec tsx ./tools/lic.ts",
    "loc": "npx tsx ./tools/loc.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@babel/core": "^7.22.20",
    "@babel/eslint-parser": "^7.22.15",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commander": "^15.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "glob": "^13.0.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "cross-fetch": "^4.1.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.6",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.3",
    "mongoose": "^9.9.1",
    "nanoid": "^6.0.1",
    "openai": "^7.4.0",
    "qs": "^6.15.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  }
}
